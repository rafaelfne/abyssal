{
  "extends": "./tooling/typescript/base.json",
  "compilerOptions": {
    "allowJs": true,
    "composite": false,
    "jsx": "react-jsx",
    "noEmit": true,
    "paths": {
      "@abyssal/contracts": ["./packages/contracts/src/index.ts"],
      "@abyssal/domain": ["./packages/domain/src/index.ts"]
    },
    "types": ["node"]
  },
  "include": [
    "apps/**/*.ts",
    "apps/**/*.tsx",
    "packages/**/*.ts",
    "scripts/**/*.ts",
    "tooling/**/*.ts",
    "*.mjs"
  ]
}
